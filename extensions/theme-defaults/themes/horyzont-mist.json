		"editorBracketHighlight.foreground4": "#66707C",
		"editorBracketHighlight.foreground5": "#7656A8",
		"editorBracketHighlight.foreground6": "#3460A8",
		"editorBracketHighlight.unexpectedBracket.foreground": "#B4505A",
