{
  "name": "horyzont-defaults",
  "displayName": "Horyzont Defaults",
  "description": "Opinionated 2026 defaults for the Horyzont editor: modern typography, smooth motion, focused layout, privacy by default.",
  "version": "1.0.0",
  "publisher": "vscode",
  "license": "MIT",
  "engines": {
    "vscode": "*"
  },
  "categories": [
    "Other"
  ],
  "contributes": {
    "configurationDefaults": {
      "workbench.colorTheme": "Horyzont Night",
      "workbench.iconTheme": "horyzont-icons",
      "extensions.ignoreRecommendations": true,
      "workbench.preferredDarkColorTheme": "Horyzont Night",
      "workbench.preferredLightColorTheme": "Horyzont Dawn",
      "window.autoDetectColorScheme": true,
      "window.commandCenter": true,
      "window.menuBarVisibility": "compact",
      "workbench.layoutControl.enabled": false,
      "workbench.navigationControl.enabled": false,
      "workbench.activityBar.location": "top",
      "chat.titleBar.signIn.enabled": false,
      "chat.titleBar.openInAgentsWindow.enabled": false,
      "workbench.editor.tabActionLocation": "right",
      "workbench.editor.decorations.colors": true,
      "workbench.panel.showLabels": true,
      "workbench.secondarySideBar.defaultVisibility": "hidden",
      "workbench.startupEditor": "welcomePageInEmptyWorkbench",
      "workbench.tips.enabled": false,
      "workbench.tree.indent": 12,
      "workbench.tree.renderIndentGuides": "onHover",
      "breadcrumbs.enabled": false,
      "workbench.list.smoothScrolling": true,
      "workbench.editor.highlightModifiedTabs": true,
      "terminal.integrated.fontFamily": "'JetBrains Mono', 'Cascadia Mono', Consolas, monospace",
      "editor.fontFamily": "'JetBrains Mono', 'Cascadia Code', 'Fira Code', Consolas, 'Courier New', monospace",
      "editor.fontLigatures": true,
      "editor.fontSize": 14,
      "editor.lineHeight": 1.6,
      "editor.padding.top": 16,
      "editor.overviewRulerBorder": false,
      "editor.hideCursorInOverviewRuler": true,
      "editor.scrollbar.verticalScrollbarSize": 8,
      "editor.scrollbar.horizontalScrollbarSize": 8,
      "editor.guides.indentation": false,
      "editor.glyphMargin": false,
      "editor.showFoldingControls": "mouseover",
      "editor.lightbulb.enabled": "onCode",
      "editor.cursorBlinking": "smooth",
      "editor.cursorSmoothCaretAnimation": "on",
      "editor.smoothScrolling": true,
      "editor.minimap.enabled": false,
      "editor.stickyScroll.enabled": true,
      "editor.guides.bracketPairs": false,
      "editor.renderLineHighlight": "all",
      "editor.linkedEditing": true,
      "editor.inlayHints.enabled": "onUnlessPressed",
      "editor.inlineSuggest.enabled": true,
      "files.autoSave": "afterDelay",
      "files.trimTrailingWhitespace": true,
      "files.insertFinalNewline": true,
      "explorer.compactFolders": false,
      "terminal.integrated.smoothScrolling": true,
      "terminal.integrated.stickyScroll.enabled": true,
      "terminal.integrated.cursorStyle": "line",
      "git.autofetch": true,
      "git.confirmSync": false,
      "telemetry.telemetryLevel": "off",
      "zenMode.fullScreen": false,
      "zenMode.centerLayout": true,
      "zenMode.showTabs": "none",
      "zenMode.hideStatusBar": true,
      "zenMode.hideActivityBar": true,
      "zenMode.hideLineNumbers": false,
      "zenMode.silentNotifications": true,
      "zenMode.restore": false,
      "workbench.enableExperiments": false,
      "workbench.settings.enableNaturalLanguageSearch": false,
      "workbench.editor.limit.enabled": true,
      "workbench.editor.limit.value": 12,
      "workbench.editor.limit.excludeDirty": true,
      "search.followSymlinks": false,
      "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/node_modules/*/**": true,
        "**/.hg/store/**": true,
        "**/.venv/**": true,
        "**/__pycache__/**": true,
        "**/target/**": true,
        "**/.next/**": true,
        "**/.gradle/**": true
      },
      "search.exclude": {
        "**/node_modules": true,
        "**/bower_components": true,
        "**/*.code-search": true,
        "**/.venv": true,
        "**/.next": true,
        "**/coverage": true
      },
      "extensions.autoCheckUpdates": true,
      "extensions.autoUpdate": "onlyEnabledExtensions"
    }
  }
}
